# ==============================================================================
# Fomeora Environment Configuration Template
# Best Practice: NEVER commit production credentials to source control.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Database & Cache
DATABASE_URL=postgresql://fomeora_user:fomeora_password@localhost:5432/fomeora?schema=public
REDIS_URL=redis://localhost:6379

# Blockchain RPCs
RPC_URL_ROBINHOOD=http://localhost:8545
RPC_URL_HYPEREVM=https://api.hyperliquid.xyz/evm
DEFAULT_CHAIN_ID=31337

# Auth: Sign in with X (OAuth 2.0 PKCE)
# Scopes: users.read tweet.read offline.access (NEVER tweet.write)
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
X_CALLBACK_URL=http://localhost:4000/v1/auth/x/callback

# Auth: Session & SIWE Security
SESSION_SECRET=super_secure_random_secret_at_least_32_characters_long
JWT_SECRET=super_secure_jwt_secret_at_least_32_characters_long
SIWE_DOMAIN=localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Contract Addresses (Local Anvil / Testnet)
DLMM_POOL_V2_FACTORY=0x0000000000000000000000000000000000000000
POSITION_MANAGER_V2=0x0000000000000000000000000000000000000000
DLMM_LENS=0x0000000000000000000000000000000000000000
