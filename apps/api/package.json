{
  "name": "@fomeora/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "verify:realtime": "tsx scripts/verify-realtime.ts",
    "verify:database-security": "tsx scripts/verify-database-security.ts",
    "verify:wallet-link": "tsx scripts/verify-wallet-link.ts",
    "verify:x-auth": "tsx scripts/verify-x-auth.ts",
    "verify:swap": "tsx scripts/verify-swap.ts",
    "verify:position-create": "tsx scripts/verify-position-create.ts",
    "verify:position-actions": "tsx scripts/verify-position-actions.ts",
    "verify:callout-feed": "tsx scripts/verify-callout-feed.ts",
    "verify:tail": "tsx scripts/verify-tail.ts",
    "verify:tail-prepare": "tsx scripts/verify-tail-prepare.ts",
    "verify:social": "tsx scripts/verify-social.ts",
    "refresh:x-profiles": "tsx scripts/refresh-x-profiles.ts"
  },
  "dependencies": {
    "@fomeora/contracts-sdk": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/cookie": "^9.3.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fomeora/database": "workspace:*",
    "@fomeora/env": "workspace:*",
    "@fomeora/sdk": "workspace:*",
    "@fomeora/types": "workspace:*",
    "fastify": "^4.28.1",
    "pg": "^8.13.1",
    "viem": "^2.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@fomeora/eslint-config": "workspace:*",
    "@fomeora/config-typescript": "workspace:*",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.10",
    "eslint": "^8.57.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
