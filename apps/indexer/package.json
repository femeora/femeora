{
  "name": "@fomeora/indexer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "sync:once": "node dist/sync-once.js",
    "backfill:reference": "node dist/backfill-reference.js",
    "backfill:external-reference": "node dist/backfill-external-reference.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "verify:position-value": "tsx scripts/verify-position-value.ts",
    "verify:callout-updates": "tsx scripts/verify-callout-updates.ts",
    "verify:candles": "tsx scripts/verify-candles.ts",
    "verify:stats-rollup": "tsx scripts/verify-stats-rollup.ts",
    "verify:reputation": "tsx scripts/verify-reputation.ts",
    "verify:reorg-social": "tsx scripts/verify-reorg-social.ts",
    "verify:intent-linking": "tsx scripts/verify-intent-linking.ts"
  },
  "dependencies": {
    "@fomeora/contracts-sdk": "workspace:*",
    "@fomeora/database": "workspace:*",
    "@fomeora/env": "workspace:*",
    "@fomeora/sdk": "workspace:*",
    "@fomeora/types": "workspace:*",
    "viem": "^2.17.0"
  },
  "devDependencies": {
    "@fomeora/eslint-config": "workspace:*",
    "@fomeora/config-typescript": "workspace:*",
    "@types/node": "^20.14.10",
    "eslint": "^8.57.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
