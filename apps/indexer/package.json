{
  "name": "@fomeora/indexer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@fomeora/database": "workspace:*",
    "@fomeora/sdk": "workspace:*",
    "@fomeora/types": "workspace:*",
    "dotenv": "^16.4.5",
    "viem": "^2.17.0"
  },
  "devDependencies": {
    "@fomeora/eslint-config": "workspace:*",
    "@fomeora/config-typescript": "workspace:*",
    "@types/node": "^20.14.10",
    "eslint": "^8.57.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
