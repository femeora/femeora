{
  "name": "@fomeora/sdk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@fomeora/types": "workspace:*"
  },
  "devDependencies": {
    "@fomeora/eslint-config": "workspace:*",
    "@fomeora/config-typescript": "workspace:*",
    "eslint": "^8.57.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
