datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 10.1 Chain Tables
// ==========================================

model Pool {
  id                   String    @id @default(uuid()) @db.Uuid
  chainId              Int       @map("chain_id")
  address              String    @db.VarChar(42)
  type                 String    @db.VarChar(10) // 'DLMM' | 'DAMM'
  tokenX               String    @map("token_x")
  tokenY               String    @map("token_y")
  tokenXDecimals       Int?      @map("token_x_decimals")
  tokenYDecimals       Int?      @map("token_y_decimals")
  quoteToken           String?   @map("quote_token")
  binStep              Int       @map("bin_step")
  baseFeePips          Int       @map("base_fee_pips")
  reserveCapX          Decimal?  @map("reserve_cap_x") @db.Decimal(78, 0)
  reserveCapY          Decimal?  @map("reserve_cap_y") @db.Decimal(78, 0)
  reserveX             Decimal?  @map("reserve_x") @db.Decimal(78, 0)
  reserveY             Decimal?  @map("reserve_y") @db.Decimal(78, 0)
  reserveUpdatedBlock  BigInt?   @map("reserve_updated_block")
  lastReserveRefreshAt DateTime? @map("last_reserve_refresh_at")
  initialActiveBin     Int?      @map("initial_active_bin")
  activeBin            Int?      @map("active_bin")
  lastValueRefreshAt   DateTime? @map("last_value_refresh_at")
  createdBlock         BigInt    @map("created_block")
  canonical            Boolean   @default(true)
  visible              Boolean   @default(true)

  positions        Position[]
  positionBins     PositionBin[]
  callouts         Callout[]
  bins             Bin[]
  swaps            Swap[]
  binFeeAccruals   BinFeeAccrual[]
  shareCheckpoints PositionShareCheckpoint[]
  feeCredits       PositionFeeCredit[]
  candles          Candle[]
  referenceCandles ReferenceCandle[]
  intents          CalloutIntent[]

  @@unique([chainId, address])
  @@map("pools")
}

model AssetCatalog {
  chainId           Int      @map("chain_id")
  address           String   @db.VarChar(42)
  source            String   @db.VarChar(20)
  sourceAssetId     String?  @map("source_asset_id") @db.VarChar(80)
  symbol            String   @db.VarChar(64)
  name              String   @db.VarChar(160)
  decimals          Int
  logoUrl           String?  @map("logo_url") @db.Text
  category          String   @db.VarChar(20)
  isin              String?  @db.VarChar(32)
  status            String   @db.VarChar(64)
  currentMultiplier String?  @map("current_multiplier") @db.VarChar(80)
  marketStatus      String?  @map("market_status") @db.VarChar(64)
  extendedStatus    String?  @map("extended_status") @db.VarChar(64)
  overnightStatus   String?  @map("overnight_status") @db.VarChar(64)
  sourceUpdatedAt   DateTime @map("source_updated_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@id([chainId, address])
  @@index([chainId, category, status])
  @@map("asset_catalog")
}

model AssetDisplayConfig {
  chainId               Int      @map("chain_id")
  address               String   @db.VarChar(42)
  candidateEnabled      Boolean  @default(true) @map("candidate_enabled")
  candidateRank         Int?     @map("candidate_rank")
  candidateQuoteAddress String?  @map("candidate_quote_address") @db.VarChar(42)
  logoUrl               String?  @map("logo_url") @db.Text
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@id([chainId, address])
  @@index([chainId, candidateEnabled, candidateRank])
  @@map("asset_display_configs")
}

model ChainCursor {
  chainId            Int      @id @map("chain_id")
  nextBlock          BigInt   @map("next_block")
  lastProcessedBlock BigInt?  @map("last_processed_block")
  lastProcessedHash  String?  @map("last_processed_hash") @db.VarChar(66)
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("chain_cursors")
}

model Launchpad {
  chainId                 Int      @map("chain_id")
  launchpadId             BigInt   @map("launchpad_id")
  owner                   String   @db.VarChar(42)
  feeRecipient            String   @map("fee_recipient") @db.VarChar(42)
  admins                  String[] @default([])
  name                    String   @db.VarChar(120)
  slug                    String   @db.VarChar(80)
  metadataUri             String   @map("metadata_uri") @db.Text
  domain                  String   @db.VarChar(255)
  xHandle                 String   @map("x_handle") @db.VarChar(64)
  quoteToken              String   @map("quote_token") @db.VarChar(42)
  tradeFeePips            Int      @map("trade_fee_pips")
  creatorSharePips        Int      @map("creator_share_pips")
  launchpadSharePips      Int      @map("launchpad_share_pips")
  protocolSharePips       Int      @map("protocol_share_pips")
  lpCreatorSharePips      Int      @map("lp_creator_share_pips")
  lpLaunchpadSharePips    Int      @map("lp_launchpad_share_pips")
  lpProtocolSharePips     Int      @map("lp_protocol_share_pips")
  graduationThreshold     Decimal  @map("graduation_threshold") @db.Decimal(78, 0)
  curveTokenSupply        Decimal  @map("curve_token_supply") @db.Decimal(78, 0)
  graduationTarget        String   @map("graduation_target") @db.VarChar(12)
  startFeePips            Int      @map("start_fee_pips")
  endFeePips              Int      @map("end_fee_pips")
  feeDurationSeconds      Int      @map("fee_duration_seconds")
  feeCurve                String   @map("fee_curve") @db.VarChar(16)
  protectionEnabled       Boolean  @map("protection_enabled")
  xRequired               Boolean  @map("x_required")
  devBuyCapPips           Int      @map("dev_buy_cap_pips")
  earlyBuyCapPips         Int      @map("early_buy_cap_pips")
  earlyBuyDurationSeconds Int      @map("early_buy_duration_seconds")
  active                  Boolean  @default(true)
  transactionHash         String   @map("transaction_hash") @db.VarChar(66)
  blockNumber             BigInt   @map("block_number")
  createdAt               DateTime @map("created_at")
  canonical               Boolean  @default(true)

  launches     Launch[]
  statusEvents LaunchpadStatusEvent[]
  likes        LaunchpadLike[]
  reposts      LaunchpadRepost[]
  replies      LaunchpadReply[]
  views        LaunchpadViewDaily[]
  reputations  LaunchpadReputation[]

  @@id([chainId, launchpadId])
  @@unique([chainId, slug])
  @@index([chainId, owner, active])
  @@map("launchpads")
}

model LaunchpadStatusEvent {
  chainId         Int      @map("chain_id")
  transactionHash String   @map("transaction_hash") @db.VarChar(66)
  logIndex        Int      @map("log_index")
  launchpadId     BigInt   @map("launchpad_id")
  active          Boolean
  blockNumber     BigInt   @map("block_number")
  timestamp       DateTime
  canonical       Boolean  @default(true)

  launchpad Launchpad @relation(fields: [chainId, launchpadId], references: [chainId, launchpadId], onDelete: Cascade)

  @@id([chainId, transactionHash, logIndex])
  @@index([chainId, launchpadId, blockNumber])
  @@map("launchpad_status_events")
}

model Launch {
  chainId         Int      @map("chain_id")
  launchId        BigInt   @map("launch_id")
  launchpadId     BigInt   @map("launchpad_id")
  creator         String   @db.VarChar(42)
  token           String   @db.VarChar(42)
  curve           String   @db.VarChar(42)
  name            String   @db.VarChar(120)
  symbol          String   @db.VarChar(32)
  metadataUri     String   @map("metadata_uri") @db.Text
  totalSupply     Decimal  @map("total_supply") @db.Decimal(78, 0)
  quoteReserve    Decimal  @default(0) @map("quote_reserve") @db.Decimal(78, 0)
  tokenInventory  Decimal  @map("token_inventory") @db.Decimal(78, 0)
  progressPips    Int      @default(0) @map("progress_pips")
  status          String   @default("curve") @db.VarChar(20)
  transactionHash String   @map("transaction_hash") @db.VarChar(66)
  blockNumber     BigInt   @map("block_number")
  createdAt       DateTime @map("created_at")
  canonical       Boolean  @default(true)

  launchpad  Launchpad          @relation(fields: [chainId, launchpadId], references: [chainId, launchpadId], onDelete: Restrict)
  trades     CurveTrade[]
  graduation Graduation?
  revenue    LaunchpadRevenue[]

  @@id([chainId, launchId])
  @@unique([chainId, token])
  @@unique([chainId, curve])
  @@index([chainId, launchpadId, createdAt])
  @@index([chainId, status, createdAt])
  @@map("launches")
}

model CurveTrade {
  chainId         Int      @map("chain_id")
  transactionHash String   @map("transaction_hash") @db.VarChar(66)
  logIndex        Int      @map("log_index")
  launchId        BigInt   @map("launch_id")
  side            String   @db.VarChar(8)
  trader          String   @db.VarChar(42)
  recipient       String   @db.VarChar(42)
  quoteAmount     Decimal  @map("quote_amount") @db.Decimal(78, 0)
  tokenAmount     Decimal  @map("token_amount") @db.Decimal(78, 0)
  feeAmount       Decimal  @map("fee_amount") @db.Decimal(78, 0)
  quoteReserve    Decimal  @map("quote_reserve") @db.Decimal(78, 0)
  tokenInventory  Decimal  @map("token_inventory") @db.Decimal(78, 0)
  progressPips    Int      @map("progress_pips")
  blockNumber     BigInt   @map("block_number")
  timestamp       DateTime
  canonical       Boolean  @default(true)

  launch Launch @relation(fields: [chainId, launchId], references: [chainId, launchId], onDelete: Cascade)

  @@id([chainId, transactionHash, logIndex])
  @@index([chainId, launchId, timestamp])
  @@map("curve_trades")
}

model Graduation {
  chainId         Int      @map("chain_id")
  launchId        BigInt   @map("launch_id")
  pool            String   @db.VarChar(42)
  positionId      BigInt   @map("position_id")
  tokenAmount     Decimal  @map("token_amount") @db.Decimal(78, 0)
  quoteAmount     Decimal  @map("quote_amount") @db.Decimal(78, 0)
  transactionHash String   @map("transaction_hash") @db.VarChar(66)
  blockNumber     BigInt   @map("block_number")
  timestamp       DateTime
  canonical       Boolean  @default(true)

  launch Launch @relation(fields: [chainId, launchId], references: [chainId, launchId], onDelete: Cascade)

  @@id([chainId, launchId])
  @@unique([chainId, pool])
  @@unique([chainId, positionId])
  @@map("graduations")
}

model LaunchpadRevenue {
  chainId         Int      @map("chain_id")
  transactionHash String   @map("transaction_hash") @db.VarChar(66)
  logIndex        Int      @map("log_index")
  launchId        BigInt   @map("launch_id")
  recipient       String   @db.VarChar(42)
  category        String   @db.VarChar(20)
  token           String   @db.VarChar(42)
  amount          Decimal  @db.Decimal(78, 0)
  blockNumber     BigInt   @map("block_number")
  timestamp       DateTime
  canonical       Boolean  @default(true)

  launch Launch @relation(fields: [chainId, launchId], references: [chainId, launchId], onDelete: Cascade)

  @@id([chainId, transactionHash, logIndex, category])
  @@index([chainId, launchId, timestamp])
  @@index([chainId, recipient, timestamp])
  @@map("launchpad_revenue")
}

model LaunchpadReputation {
  chainId              Int      @map("chain_id")
  launchpadId          BigInt   @map("launchpad_id")
  window               String   @db.VarChar(10)
  launches             Int      @default(0)
  eligibleLaunches     Int      @default(0) @map("eligible_launches")
  graduations          Int      @default(0)
  survivedGraduations  Int      @default(0) @map("survived_graduations")
  graduationRate       Decimal  @default(0) @map("graduation_rate") @db.Decimal(5, 2)
  survivalRate         Decimal  @default(0) @map("survival_rate") @db.Decimal(5, 2)
  medianTimeToGraduate BigInt?  @map("median_time_to_graduate")
  devExitRate          Decimal  @default(0) @map("dev_exit_rate") @db.Decimal(5, 2)
  sniperShare          Decimal  @default(0) @map("sniper_share") @db.Decimal(5, 2)
  volumeQuote          Decimal  @default(0) @map("volume_quote") @db.Decimal(36, 18)
  revenueQuote         Decimal  @default(0) @map("revenue_quote") @db.Decimal(36, 18)
  protectionScore      Decimal  @default(0) @map("protection_score") @db.Decimal(5, 2)
  score                Decimal  @default(0) @db.Decimal(5, 2)
  tier                 String   @default("Unrated") @db.VarChar(12)
  computedAt           DateTime @map("computed_at")

  launchpad Launchpad @relation(fields: [chainId, launchpadId], references: [chainId, launchpadId], onDelete: Cascade)

  @@id([chainId, launchpadId, window])
  @@index([chainId, window, score])
  @@index([chainId, window, revenueQuote])
  @@map("launchpad_reputations")
}

model ProtectedTokenIdentity {
  chainId     Int      @map("chain_id")
  token       String   @db.VarChar(42)
  name        String   @db.VarChar(120)
  symbol      String   @db.VarChar(32)
  officialXId String   @map("official_x_id")
  verifiedAt  DateTime @map("verified_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@id([chainId, token])
  @@index([chainId, symbol])
  @@index([officialXId])
  @@map("protected_token_identities")
}

model IndexerHealth {
  chainId                Int       @id @map("chain_id")
  status                 String    @db.VarChar(20)
  latestBlock            BigInt    @map("latest_block")
  safeBlock              BigInt    @map("safe_block")
  lastIndexedBlock       BigInt?   @map("last_indexed_block")
  lagBlocks              BigInt    @map("lag_blocks")
  lastSuccessAt          DateTime? @map("last_success_at")
  lastStatsRollupAt      DateTime? @map("last_stats_rollup_at")
  lastReputationRollupAt DateTime? @map("last_reputation_rollup_at")
  lastErrorCode          String?   @map("last_error_code") @db.VarChar(80)
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("indexer_health")
}

model CanonicalBlock {
  chainId     Int      @map("chain_id")
  blockNumber BigInt   @map("block_number")
  hash        String   @db.VarChar(66)
  parentHash  String   @map("parent_hash") @db.VarChar(66)
  timestamp   DateTime
  canonical   Boolean  @default(true)
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([chainId, blockNumber])
  @@unique([chainId, hash])
  @@index([chainId, canonical, blockNumber])
  @@map("canonical_blocks")
}

model Bin {
  poolId       String  @map("pool_id") @db.Uuid
  binId        Int     @map("bin_id")
  reserveX     Decimal @map("reserve_x") @db.Decimal(78, 0)
  reserveY     Decimal @map("reserve_y") @db.Decimal(78, 0)
  totalShares  Decimal @map("total_shares") @db.Decimal(78, 0)
  updatedBlock BigInt  @map("updated_block")

  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@id([poolId, binId])
  @@map("bins")
}

model Swap {
  id               String   @id @default(uuid()) @db.Uuid
  chainId          Int      @map("chain_id")
  poolId           String   @map("pool_id") @db.Uuid
  transactionHash  String   @map("transaction_hash") @db.VarChar(66)
  logIndex         Int      @map("log_index")
  transactionIndex Int      @default(0) @map("transaction_index")
  blockNumber      BigInt   @map("block_number")
  blockHash        String   @map("block_hash") @db.VarChar(66)
  timestamp        DateTime
  sender           String   @db.VarChar(42)
  recipient        String   @db.VarChar(42)
  tokenIn          String   @map("token_in") @db.VarChar(42)
  amountIn         Decimal  @map("amount_in") @db.Decimal(78, 0)
  amountOut        Decimal  @map("amount_out") @db.Decimal(78, 0)
  totalFee         Decimal? @map("total_fee") @db.Decimal(78, 0)
  protocolFee      Decimal  @default(0) @map("protocol_fee") @db.Decimal(78, 0)
  activeBinBefore  Int?     @map("active_bin_before")
  activeBinAfter   Int?     @map("active_bin_after")
  binCrossings     Int?     @map("bin_crossings")
  reserveXAfter    Decimal? @map("reserve_x_after") @db.Decimal(78, 0)
  reserveYAfter    Decimal? @map("reserve_y_after") @db.Decimal(78, 0)
  canonical        Boolean  @default(true)

  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@unique([chainId, transactionHash, logIndex])
  @@index([poolId, timestamp])
  @@index([chainId, blockNumber, canonical])
  @@map("swaps")
}

model PositionShareCheckpoint {
  id               String   @id @default(uuid()) @db.Uuid
  chainId          Int      @map("chain_id")
  positionId       BigInt   @map("position_id")
  poolId           String   @map("pool_id") @db.Uuid
  transactionHash  String   @map("transaction_hash") @db.VarChar(66)
  transactionIndex Int      @map("transaction_index")
  logIndex         Int      @map("log_index")
  blockNumber      BigInt   @map("block_number")
  blockHash        String   @map("block_hash") @db.VarChar(66)
  timestamp        DateTime
  binId            Int      @map("bin_id")
  shares           Decimal  @db.Decimal(78, 0)
  canonical        Boolean  @default(true)

  position Position @relation(fields: [chainId, positionId], references: [chainId, id], onDelete: Cascade)
  pool     Pool     @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@unique([chainId, transactionHash, logIndex, binId])
  @@index([chainId, positionId, binId, blockNumber])
  @@index([poolId, binId, blockNumber, canonical])
  @@map("position_share_checkpoints")
}

model PositionFeeCredit {
  id          String   @id @default(uuid()) @db.Uuid
  accrualId   String   @map("accrual_id") @db.Uuid
  chainId     Int      @map("chain_id")
  positionId  BigInt   @map("position_id")
  poolId      String   @map("pool_id") @db.Uuid
  timestamp   DateTime
  tokenIn     String   @map("token_in") @db.VarChar(42)
  amountRaw   Decimal  @map("amount_raw") @db.Decimal(78, 0)
  amountQuote Decimal? @map("amount_quote") @db.Decimal(36, 18)
  canonical   Boolean  @default(true)

  accrual  BinFeeAccrual @relation(fields: [accrualId], references: [id], onDelete: Cascade)
  position Position      @relation(fields: [chainId, positionId], references: [chainId, id], onDelete: Cascade)
  pool     Pool          @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@unique([accrualId, chainId, positionId])
  @@index([chainId, positionId, timestamp, canonical])
  @@index([poolId, timestamp, canonical])
  @@map("position_fee_credits")
}

model BinFeeAccrual {
  id               String   @id @default(uuid()) @db.Uuid
  chainId          Int      @map("chain_id")
  poolId           String   @map("pool_id") @db.Uuid
  transactionHash  String   @map("transaction_hash") @db.VarChar(66)
  logIndex         Int      @map("log_index")
  transactionIndex Int      @map("transaction_index")
  blockNumber      BigInt   @map("block_number")
  blockHash        String   @map("block_hash") @db.VarChar(66)
  timestamp        DateTime
  binId            Int      @map("bin_id")
  tokenIn          String   @map("token_in") @db.VarChar(42)
  lpFee            Decimal  @map("lp_fee") @db.Decimal(78, 0)
  totalShares      Decimal  @map("total_shares") @db.Decimal(78, 0)
  canonical        Boolean  @default(true)

  pool    Pool                @relation(fields: [poolId], references: [id], onDelete: Cascade)
  credits PositionFeeCredit[]

  @@unique([chainId, transactionHash, logIndex])
  @@index([poolId, binId, blockNumber])
  @@index([chainId, blockNumber, canonical])
  @@map("bin_fee_accruals")
}

model Candle {
  poolId      String   @map("pool_id") @db.Uuid
  interval    String   @db.VarChar(8)
  bucketStart DateTime @map("bucket_start")
  open        Decimal  @db.Decimal(78, 18)
  high        Decimal  @db.Decimal(78, 18)
  low         Decimal  @db.Decimal(78, 18)
  close       Decimal  @db.Decimal(78, 18)
  volumeX     Decimal  @default(0) @map("volume_x") @db.Decimal(78, 0)
  volumeY     Decimal  @default(0) @map("volume_y") @db.Decimal(78, 0)
  swapCount   Int      @default(0) @map("swap_count")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@id([poolId, interval, bucketStart])
  @@index([poolId, interval, bucketStart])
  @@map("candles")
}

model AssetPriceSource {
  id               String   @id @default(uuid()) @db.Uuid
  chainId          Int      @map("chain_id")
  tokenAddress     String   @map("token_address") @db.VarChar(42)
  sourceType       String   @map("source_type") @db.VarChar(24)
  feedAddress      String?  @map("feed_address") @db.VarChar(42)
  symbol           String   @db.VarChar(32)
  quoteCurrency    String   @default("USD") @map("quote_currency") @db.VarChar(12)
  heartbeatSeconds Int      @default(86400) @map("heartbeat_seconds")
  priority         Int      @default(100)
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([chainId, tokenAddress, sourceType])
  @@index([chainId, enabled, priority])
  @@map("asset_price_sources")
}

model ReferenceCandle {
  poolId          String   @map("pool_id") @db.Uuid
  interval        String   @db.VarChar(8)
  bucketStart     DateTime @map("bucket_start")
  open            Decimal  @db.Decimal(78, 18)
  high            Decimal  @db.Decimal(78, 18)
  low             Decimal  @db.Decimal(78, 18)
  close           Decimal  @db.Decimal(78, 18)
  sourceType      String   @map("source_type") @db.VarChar(24)
  sourceUpdatedAt DateTime @map("source_updated_at")
  stale           Boolean  @default(false)
  updatedAt       DateTime @updatedAt @map("updated_at")

  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@id([poolId, interval, bucketStart])
  @@index([poolId, interval, bucketStart])
  @@map("reference_candles")
}

model Position {
  id                  BigInt    @map("id")
  chainId             Int       @map("chain_id")
  poolId              String    @map("pool_id") @db.Uuid
  owner               String    @db.VarChar(42)
  lowerBin            Int       @map("lower_bin")
  upperBin            Int       @map("upper_bin")
  shape               Int       @db.SmallInt
  tag                 String?   @db.VarChar(66) // 0x... bytes32
  referrer            String?   @db.VarChar(42)
  status              String    @db.VarChar(20) // 'open' | 'closed' | 'transferred'
  depositedQuote      Decimal   @default(0) @map("deposited_quote") @db.Decimal(36, 18)
  withdrawnQuote      Decimal   @default(0) @map("withdrawn_quote") @db.Decimal(36, 18)
  openingQuote        Decimal   @default(0) @map("opening_quote") @db.Decimal(36, 18)
  earnedQuote         Decimal   @default(0) @map("earned_quote") @db.Decimal(36, 18)
  valueQuote          Decimal?  @map("value_quote") @db.Decimal(36, 18)
  valueQuoteUpdatedAt DateTime? @map("value_quote_updated_at")
  valueQuoteBlock     BigInt?   @map("value_quote_block")
  inRangeSeconds      BigInt    @default(0) @map("in_range_seconds")
  openSeconds         BigInt    @default(0) @map("open_seconds")
  openedAt            DateTime  @default(now()) @map("opened_at")
  closedAt            DateTime? @map("closed_at")
  canonical           Boolean   @default(true)

  pool             Pool                      @relation(fields: [poolId], references: [id])
  callouts         Callout[]
  bins             PositionBin[]
  events           PositionEvent[]
  shareCheckpoints PositionShareCheckpoint[]
  feeCredits       PositionFeeCredit[]

  @@id([chainId, id])
  @@index([owner])
  @@index([poolId])
  @@map("positions")
}

model PositionBin {
  chainId    Int     @map("chain_id")
  positionId BigInt  @map("position_id")
  poolId     String  @map("pool_id") @db.Uuid
  binId      Int     @map("bin_id")
  shares     Decimal @db.Decimal(78, 0)

  position Position @relation(fields: [chainId, positionId], references: [chainId, id], onDelete: Cascade)
  pool     Pool     @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@id([chainId, positionId, binId])
  @@index([chainId, binId])
  @@index([poolId, binId])
  @@map("position_bins")
}

model PositionEvent {
  id              String   @id @default(uuid()) @db.Uuid
  chainId         Int      @map("chain_id")
  transactionHash String   @map("transaction_hash") @db.VarChar(66)
  logIndex        Int      @map("log_index")
  positionId      BigInt   @map("position_id")
  blockNumber     BigInt   @map("block_number")
  blockHash       String   @map("block_hash") @db.VarChar(66)
  timestamp       DateTime
  eventType       String   @map("event_type") @db.VarChar(40)
  owner           String?  @db.VarChar(42)
  canonical       Boolean  @default(true)
  payload         Json
  cashFlowType    String?  @map("cash_flow_type") @db.VarChar(16)
  amountQuote     Decimal? @map("amount_quote") @db.Decimal(36, 18)

  position Position        @relation(fields: [chainId, positionId], references: [chainId, id], onDelete: Cascade)
  updates  CalloutUpdate[]

  @@unique([chainId, transactionHash, logIndex])
  @@index([chainId, positionId, blockNumber])
  @@index([chainId, blockNumber, canonical])
  @@map("position_events")
}

// ==========================================
// 10.2 Social Tables (Global Schema)
// ==========================================

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  xId                 String    @unique @map("x_id")
  handle              String    @unique
  name                String?
  avatarUrl           String?   @map("avatar_url")
  xVerified           Boolean   @default(false) @map("x_verified")
  xFollowers          Int       @default(0) @map("x_followers")
  xProfileRefreshedAt DateTime? @map("x_profile_refreshed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  banned              Boolean   @default(false)

  wallets            Wallet[]
  callouts           Callout[]
  calloutIntents     CalloutIntent[]
  likes              Like[]
  reposts            Repost[]
  replies            Reply[]
  stats              UserStat[]
  sessions           Session[]
  oauthStates        OAuthState[]
  walletChallenges   WalletLinkChallenge[]
  following          Follow[]              @relation("FollowFollower")
  followers          Follow[]              @relation("FollowFollowee")
  notifications      Notification[]        @relation("NotificationRecipient")
  actedNotifications Notification[]        @relation("NotificationActor")
  reports            Report[]
  launchpadLikes     LaunchpadLike[]
  launchpadReposts   LaunchpadRepost[]
  launchpadReplies   LaunchpadReply[]

  @@index([xProfileRefreshedAt])
  @@map("users")
}

model Wallet {
  address    String   @id @db.VarChar(42)
  userId     String   @map("user_id") @db.Uuid
  linkedAt   DateTime @default(now()) @map("linked_at")
  verifiedAt DateTime @default(now()) @map("verified_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallets")
}

model Callout {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  kind             String    @default("position") @db.VarChar(20)
  launchId         BigInt?   @map("launch_id")
  chainId          Int       @map("chain_id")
  positionId       BigInt    @map("position_id")
  poolId           String    @map("pool_id") @db.Uuid
  caption          String?   @db.VarChar(280)
  captionEditedAt  DateTime? @map("caption_edited_at")
  showSize         Boolean   @default(true) @map("show_size")
  deletedAt        DateTime? @map("deleted_at")
  mcAtPost         Decimal?  @map("mc_at_post") @db.Decimal(36, 18)
  priceAtPost      Decimal?  @map("price_at_post") @db.Decimal(36, 18)
  sizeAtPost       Decimal?  @map("size_at_post") @db.Decimal(36, 18)
  side             String?   @db.VarChar(30)
  shape            Int       @db.SmallInt
  lowerBin         Int       @map("lower_bin")
  upperBin         Int       @map("upper_bin")
  createdAt        DateTime  @default(now()) @map("created_at")
  status           String    @db.VarChar(20)
  hidden           Boolean   @default(false)
  canonical        Boolean   @default(true)
  quickExitMinutes Int?      @map("quick_exit_minutes")
  hasOppositeSide  Boolean?  @map("has_opposite_side")
  isFreshWallet    Boolean?  @map("is_fresh_wallet")
  isDevOrTopHolder Boolean?  @map("is_dev_or_top_holder")

  user        User            @relation(fields: [userId], references: [id])
  pool        Pool            @relation(fields: [poolId], references: [id])
  position    Position        @relation(fields: [chainId, positionId], references: [chainId, id])
  likes       Like[]
  reposts     Repost[]
  replies     Reply[]
  tails       Tail[]
  updates     CalloutUpdate[]
  views       ViewDaily[]
  tailIntents CalloutIntent[] @relation("TailIntentSource")

  @@unique([chainId, positionId])
  @@index([userId])
  @@index([poolId])
  @@index([chainId, launchId])
  @@index([createdAt])
  @@map("callouts")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model OAuthState {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String?   @map("user_id") @db.Uuid
  stateHash    String    @unique @map("state_hash") @db.Char(64)
  redirectPath String?   @map("redirect_path") @db.VarChar(512)
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt, consumedAt])
  @@map("oauth_states")
}

model WalletLinkChallenge {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  walletAddress String    @map("wallet_address") @db.VarChar(42)
  nonceHash     String    @unique @map("nonce_hash") @db.Char(64)
  messageHash   String    @map("message_hash") @db.VarChar(66)
  chainId       Int       @map("chain_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  expiresAt     DateTime  @map("expires_at")
  consumedAt    DateTime? @map("consumed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([walletAddress, consumedAt])
  @@map("wallet_link_challenges")
}

model CalloutIntent {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  chainId         Int       @map("chain_id")
  poolId          String    @map("pool_id") @db.Uuid
  caption         String?   @db.VarChar(280)
  showSize        Boolean   @default(true) @map("show_size")
  tag             String    @unique @db.VarChar(66)
  kind            String    @default("callout") @db.VarChar(20)
  mode            String?   @db.VarChar(30)
  referrer        String?   @db.VarChar(42)
  sourceCalloutId String?   @map("source_callout_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  expiresAt       DateTime  @map("expires_at")
  consumedAt      DateTime? @map("consumed_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pool          Pool     @relation(fields: [poolId], references: [id], onDelete: Cascade)
  sourceCallout Callout? @relation("TailIntentSource", fields: [sourceCalloutId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([chainId, poolId, expiresAt])
  @@index([sourceCalloutId, expiresAt])
  @@map("callout_intents")
}

model CalloutUpdate {
  id              String   @id @default(uuid()) @db.Uuid
  calloutId       String   @map("callout_id") @db.Uuid
  positionEventId String   @map("position_event_id") @db.Uuid
  type            String   @db.VarChar(20)
  caption         String?  @db.VarChar(280)
  createdAt       DateTime @default(now()) @map("created_at")

  callout       Callout       @relation(fields: [calloutId], references: [id], onDelete: Cascade)
  positionEvent PositionEvent @relation(fields: [positionEventId], references: [id], onDelete: Cascade)

  @@unique([positionEventId])
  @@index([calloutId, createdAt])
  @@map("callout_updates")
}

model Follow {
  followerId String   @map("follower_id") @db.Uuid
  followeeId String   @map("followee_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  follower User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("FollowFollowee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@id([followerId, followeeId])
  @@index([followeeId, createdAt])
  @@map("follows")
}

model ViewDaily {
  calloutId  String   @map("callout_id") @db.Uuid
  day        DateTime @db.Date
  viewerHash String   @map("viewer_hash") @db.Char(64)

  callout Callout @relation(fields: [calloutId], references: [id], onDelete: Cascade)

  @@id([calloutId, day, viewerHash])
  @@map("views_daily")
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  type        String    @db.VarChar(40)
  entityType  String?   @map("entity_type") @db.VarChar(40)
  entityId    String?   @map("entity_id") @db.VarChar(128)
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  readAt      DateTime? @map("read_at")

  user  User  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model Report {
  id         String    @id @default(uuid()) @db.Uuid
  reporterId String    @map("reporter_id") @db.Uuid
  type       String    @db.VarChar(40)
  targetId   String    @map("target_id") @db.VarChar(128)
  reason     String    @db.VarChar(500)
  status     String    @default("open") @db.VarChar(20)
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([type, targetId])
  @@map("reports")
}

model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  dedupKey    String    @unique @map("dedup_key") @db.VarChar(180)
  topic       String    @db.VarChar(80)
  aggregateId String?   @map("aggregate_id") @db.VarChar(128)
  chainId     Int?      @map("chain_id")
  blockNumber BigInt?   @map("block_number")
  canonical   Boolean   @default(true)
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@index([publishedAt, id])
  @@index([topic, id])
  @@index([chainId, blockNumber, canonical])
  @@map("outbox_events")
}

model Tail {
  calloutId    String   @map("callout_id") @db.Uuid
  chainId      Int      @map("chain_id")
  positionId   BigInt   @map("position_id")
  tailerUserId String?  @map("tailer_user_id") @db.Uuid
  tailerWallet String   @map("tailer_wallet") @db.VarChar(42)
  mode         String   @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at")

  callout Callout @relation(fields: [calloutId], references: [id], onDelete: Cascade)

  @@id([chainId, positionId])
  @@index([calloutId])
  @@map("tails")
}

model TailReward {
  chainId             Int      @map("chain_id")
  transactionHash     String   @map("transaction_hash") @db.VarChar(66)
  logIndex            Int      @map("log_index")
  blockNumber         BigInt   @map("block_number")
  timestamp           DateTime
  token               String   @db.VarChar(42)
  referrer            String   @db.VarChar(42)
  referrerPositionId  BigInt   @map("referrer_position_id")
  treasuryAmount      Decimal  @map("treasury_amount") @db.Decimal(78, 0)
  rewardAmount        Decimal  @map("reward_amount") @db.Decimal(78, 0)
  eligible            Boolean
  canonical           Boolean  @default(true)

  @@id([chainId, transactionHash, logIndex])
  @@index([chainId, referrerPositionId, canonical])
  @@index([chainId, referrer, canonical])
  @@index([chainId, blockNumber, canonical])
  @@map("tail_rewards")
}

model Like {
  userId    String   @map("user_id") @db.Uuid
  calloutId String   @map("callout_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  callout Callout @relation(fields: [calloutId], references: [id], onDelete: Cascade)

  @@id([userId, calloutId])
  @@map("likes")
}

model Repost {
  userId    String   @map("user_id") @db.Uuid
  calloutId String   @map("callout_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  callout Callout @relation(fields: [calloutId], references: [id], onDelete: Cascade)

  @@id([userId, calloutId])
  @@map("reposts")
}

model Reply {
  id        String   @id @default(uuid()) @db.Uuid
  calloutId String   @map("callout_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  kind      String   @default("reply") @db.VarChar(16)
  body      String   @db.VarChar(280)
  createdAt DateTime @default(now()) @map("created_at")
  hidden    Boolean  @default(false)

  user    User    @relation(fields: [userId], references: [id])
  callout Callout @relation(fields: [calloutId], references: [id], onDelete: Cascade)

  @@index([calloutId, kind, createdAt])
  @@map("replies")
}

model LaunchpadLike {
  userId      String   @map("user_id") @db.Uuid
  chainId     Int      @map("chain_id")
  launchpadId BigInt   @map("launchpad_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  launchpad Launchpad @relation(fields: [chainId, launchpadId], references: [chainId, launchpadId], onDelete: Cascade)

  @@id([userId, chainId, launchpadId])
  @@index([chainId, launchpadId, createdAt])
  @@map("launchpad_likes")
}

model LaunchpadRepost {
  userId      String   @map("user_id") @db.Uuid
  chainId     Int      @map("chain_id")
  launchpadId BigInt   @map("launchpad_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  launchpad Launchpad @relation(fields: [chainId, launchpadId], references: [chainId, launchpadId], onDelete: Cascade)

  @@id([userId, chainId, launchpadId])
  @@index([chainId, launchpadId, createdAt])
  @@map("launchpad_reposts")
}

model LaunchpadReply {
  id          String   @id @default(uuid()) @db.Uuid
  chainId     Int      @map("chain_id")
  launchpadId BigInt   @map("launchpad_id")
  userId      String   @map("user_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  kind        String   @default("reply") @db.VarChar(16)
  body        String   @db.VarChar(280)
  createdAt   DateTime @default(now()) @map("created_at")
  hidden      Boolean  @default(false)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  launchpad Launchpad @relation(fields: [chainId, launchpadId], references: [chainId, launchpadId], onDelete: Cascade)

  @@index([chainId, launchpadId, kind, createdAt])
  @@index([parentId])
  @@map("launchpad_replies")
}

model LaunchpadViewDaily {
  chainId     Int      @map("chain_id")
  launchpadId BigInt   @map("launchpad_id")
  day         DateTime @db.Date
  viewerHash  String   @map("viewer_hash") @db.Char(64)

  launchpad Launchpad @relation(fields: [chainId, launchpadId], references: [chainId, launchpadId], onDelete: Cascade)

  @@id([chainId, launchpadId, day, viewerHash])
  @@map("launchpad_views_daily")
}

model UserStat {
  userId      String   @map("user_id") @db.Uuid
  window      String   @db.VarChar(10) // '24h', '7d', '30d', 'all'
  callouts    Int      @default(0)
  earnedQuote Decimal  @default(0) @map("earned_quote") @db.Decimal(36, 18)
  avgInRange  Decimal  @default(0) @map("avg_in_range") @db.Decimal(5, 2)
  tailers     Int      @default(0)
  quickExits  Int      @default(0) @map("quick_exits")
  score       Decimal  @default(0) @db.Decimal(36, 18)
  rank        Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, window])
  @@map("user_stats")
}
